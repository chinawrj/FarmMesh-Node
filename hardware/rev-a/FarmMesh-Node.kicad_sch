		(comment 1 "Engineering review only - NOT FOR FABRICATION")
		(comment 2 "1S Li-ion battery input; no on-board charger")
	)
	(lib_symbols)
	(text "Battery: conventional 4.20V-max Li-ion, NOT LiFePO4 or HV Li-ion.\nNormal loaded operation about 3.0-4.2V; cold start about 3.3V.\nExternal protected pack required. No on-board charger or PV input.\nPCB placement, RF isolation, converter stability and throughput unvalidated.\nSee DESIGN-NOTES.md and reports/erc.json before any layout or procurement."
		(exclude_from_sim no)
		(at 25.4 226.06 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
