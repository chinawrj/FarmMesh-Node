	)
	(text "INTERFACE CONVENTION"
		(exclude_from_sim no)
		(at 25.4 165.1 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "419691cc-f032-5da4-a7d1-5682968b75ea")
	)
	(text "TX / RX are named from the C5 perspective.\nBoth TX_CLK and RX_CLK originate at that C5.\nRP drives only RX_D[0..3] and RX_VALID.\nGlobal net labels make the electrical sheet connections.\nNo wireless protocol is selected by this schematic."
		(exclude_from_sim no)
		(at 25.4 175.26 0)
