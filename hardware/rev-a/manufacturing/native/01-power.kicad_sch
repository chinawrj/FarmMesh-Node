		(uuid "5fda2274-84ce-5844-9eca-10fa3e8d372d")
	)
	(text "OUTPUT: 2.2A rail budget; 3A transient validation target.\n3 x C5 supply capability >=0.6A each + RP and margin.\nNot a guaranteed continuous 3A rating at every input/temperature."
		(exclude_from_sim no)
		(at 203.2 111.76 0)
		(effects
