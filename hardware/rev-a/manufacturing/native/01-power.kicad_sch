	(text "Q1 drain faces battery, source faces converter.\nBody diode initially conducts toward load.\nProtected pack / connector must support >=5A peak.\nFuse is not a substitute for cell protection."
		(exclude_from_sim no)
		(at 22.86 78.74 0)
		(effects
			(font
				(size 1.25 1.25)
			)
			(justify left top)
