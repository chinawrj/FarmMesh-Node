	(text "USB VBUS does not power the board or charge the battery.\nHardware disconnects USB data below approximately 4.19V VBUS, including ROM BOOTSEL.\nC5 USB pads are allocated to PARLIO; each C5 uses its UART header."
		(exclude_from_sim no)
		(at 25.4 38.1 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "38efe3dd-10a9-5a10-b5e4-5b8cef1d1aea")
	)
	(text "VBUS HARDWARE QUALIFICATION - NO FIRMWARE DEPENDENCY"
		(exclude_from_sim no)
		(at 25.4 160.02 0)
		(effects
			(font
				(size 1.4 1.4)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "53ad81de-2002-5a72-ac1b-8b5dc2af5447")
	)
	(text "GPIO37: FT input; 5.1k/7.5k divider; disable internal pulls. U104 B variant required.\nU103 OE defaults high (disconnected). VBUS trip tolerances/power ordering need sample validation.\n90 ohm USB pair: J102 -> D101 -> U103 -> 27R near RP. Keep ESD on connector side."
		(exclude_from_sim no)
		(at 25.4 271.78 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "8152c339-239e-5bfc-b03f-703cd7744629")
	)
